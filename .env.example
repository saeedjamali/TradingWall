# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/trading-wall

# NextAuth Configuration
NEXTAUTH_SECRET=your-secret-key-here-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# Public site URL (canonical SEO / Open Graph / sitemap)
# Local:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (MUST set before build on server):
NEXT_PUBLIC_SITE_URL=https://tradingwall.ir

# Optional: Google Search Console HTML tag verification code
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token

# SMS.ir Configuration
SMS_IR_API_KEY=your-sms-ir-api-key
SMS_IR_LINE_NUMBER=your-line-number

# Application Settings
NODE_ENV=development
