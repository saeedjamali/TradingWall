# Nginx for tradingwall.ir
# IMPORTANT: replace /var/www/TradingWall with your real project path

server {
    listen 80;
    server_name tradingwall.ir www.tradingwall.ir;

    # Enamad
    location = /74164599.txt {
        default_type text/plain;
        add_header Content-Type "text/plain; charset=utf-8";
        add_header Cache-Control "no-store";
        return 200 '74164599';
    }

    # Critical: serve build assets from disk (fixes Next.js 400 + MIME text/html)
    location /_next/static/ {
        alias /var/www/TradingWall/.next/static/;
        access_log off;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
