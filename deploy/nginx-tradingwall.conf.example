# نمونه کانفیگ Nginx برای tradingwall.ir + تایید اینماد
# فایل را مثلاً اینجا بگذارید: /etc/nginx/sites-available/tradingwall.ir

server {
    listen 80;
    server_name tradingwall.ir www.tradingwall.ir;

    # مهم: قبل از location / باشد — بدون رفتن به Next.js
    location = /74164599.txt {
        default_type text/plain;
        add_header Content-Type "text/plain; charset=utf-8";
        add_header Cache-Control "no-store";
        return 200 '74164599';
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# اگر SSL با Certbot دارید، همین location = /74164599.txt را
# عیناً داخل بلاک listen 443 هم کپی کنید.
